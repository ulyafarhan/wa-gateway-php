# WhatsApp Gateway Configuration
PORT=2785

# ponytail: kosongkan untuk disable auth (dev only). WAJIB diisi di production.
API_KEY=

# SOCKS5 proxy untuk bypass WhatsApp WebSocket block dari AWS/cloud IPs.
# WARP mode proxy = localhost:40000 (gratis). Kosongkan jika WA bisa konek langsung.
SOCKS5_PROXY=socks5://127.0.0.1:40000

# Direktori penyimpanan auth state per session.
AUTH_DIR=./auth_info

# Database path (SQLite)
DB_PATH=./data/wagateway.db

# Minimum interval between messages (ms). Default: 1500
RATE_LIMIT_MS=1500

# Global fallback webhook URL (per-session override via API)
WEBHOOK_URL=

# Host to bind (default: 0.0.0.0)
HOST=0.0.0.0

# Log level: silent, error, warn, info, debug
LOG_LEVEL=silent

# JWT secret — WAJIB diisi di production. Minimal 32 karakter.
JWT_SECRET=

# CORS allowed origins (comma-separated). Contoh: https://wa.gampong.web.id,http://localhost:2785
CORS_ORIGINS=https://wa.gampong.web.id,http://localhost:2785

# Production mode — mengaktifkan secure cookie flag dan helmet strict mode
NODE_ENV=production
