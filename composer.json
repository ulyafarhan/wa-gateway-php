{
    "name": "waaceh/wa-gateway",
    "description": "WA Gateway PHP SDK — WhatsApp API client for WaAceh ecosystem",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "WaAceh\\WAGateway\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WaAceh\\WAGateway\\Laravel\\WAGatewayServiceProvider"
            ],
            "aliases": {
                "WAGateway": "WaAceh\\WAGateway\\Laravel\\WAGatewayFacade"
            }
        }
    },
    "minimum-stability": "stable"
}
